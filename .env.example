# Copy to `.env` and fill in. All variables are optional — the app runs
# without them and falls back to precise merchant search links.

# --- App ---
PORT=3000
# JWT_SECRET=change-me-in-production
# SHOPSENSE_DB=./data/shopsense.db

# --- Affiliate tracking parameters (appended to outbound Buy links) ---
AFFILIATE_AMAZON_TAG=yourtag-21
AFFILIATE_FLIPKART_AFFID=your-affid
AFFILIATE_MYNTRA_SOURCE=shopsense
AFFILIATE_NYKAA_SOURCE=shopsense
AFFILIATE_CROMA_SOURCE=shopsense
AFFILIATE_AJIO_SOURCE=shopsense
AFFILIATE_TATACLIQ_SOURCE=shopsense
AFFILIATE_MEESHO_SOURCE=shopsense

# --- Product-link resolver (maps merchant + brand + title -> real product URL) ---
# Point this at your affiliate/aggregator service (Amazon PA-API wrapper,
# Rainforest, etc.). Contract:
#   request:  POST { "merchant", "brand", "title", "upc" }
#   response: { "url": "https://..." }
# Then run `npm run affiliate:resolve` to backfill offer.productUrl.
# AFFILIATE_RESOLVER_URL=https://your-resolver.example/lookup
# AFFILIATE_RESOLVER_KEY=your-api-key
# AFFILIATE_RESOLVER_DELAY_MS=250
